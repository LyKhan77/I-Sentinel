# I-Sentinel vision node environment — copy to .env and fill in.
# Loaded by systemd (EnvironmentFile=/home/gspe-ai3/project_cv/I-Sentinel/.env).

# Node id as registered in the backend DB (node table). Heartbeat 404s if missing.
VISION_NODE_ID=2

# MQTT broker, e.g. mqtt://192.168.0.10:1883
VISION_MQTT_URL=mqtt://localhost:1883

# Bearer key for /internal/* endpoints — must equal NODE_API_KEY on the API.
VISION_API_KEY=CHANGE_ME

# Base URL of the I-Sentinel API.
VISION_API_URL=http://localhost:8000

# YOLO detector settings.
VISION_DETECTOR_MODEL=yolov8n.pt
VISION_DETECTOR_NMS=0.45
VISION_DETECTOR_CONF=0.25
VISION_DETECTOR_IMGSZ=640

# Heartbeat interval in seconds. Keep below 35 (server marks nodes stale after 35s).
VISION_HEARTBEAT_S=10

# Cameras as JSON array. Example: cam_2 (192.168.0.64) sub stream via go2rtc.
VISION_CAMERAS_JSON=[{"camera_id":2,"source_url":"rtsp://localhost:8554/cam_2","ai_fps":5}]
