[Unit]
Description=I-Sentinel API
After=network.target postgresql.service

[Service]
User=gspe-ai3
WorkingDirectory=/home/gspe-ai3/project_cv/I-Sentinel/backend
EnvironmentFile=/home/gspe-ai3/project_cv/I-Sentinel/.env
ExecStart=/home/gspe-ai3/isentinel-venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always

[Install]
WantedBy=multi-user.target
