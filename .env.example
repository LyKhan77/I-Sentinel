DATABASE_URL=postgresql+psycopg://isentinel:...@localhost/isentinel
JWT_SECRET=...   # produksi: wajib >= 32 karakter acak (python -c "import secrets;print(secrets.token_urlsafe(32))")
COOKIE_SECURE=false  # true di belakang reverse proxy HTTPS; false agar LAN HTTP bisa login
NODE_API_KEY=...
# Fallback saja; normal token diisi dari UI Konfigurasi → Notifikasi dan disimpan
# di CAMERA_SECRETS_FILE (key telegram_bot_token), bukan di DB. Bot + grup: lihat README §Alert Telegram.
TELEGRAM_BOT_TOKEN=...
# Deprecated: gerbang Telegram kini toggle per behavior di Zona Deteksi.
# ALERT_MIN_SEVERITY tidak lagi memilih event mana yang dikirim.
CAM_USERNAME=...            # kredensial kamera default (override per kamera bisa)
CAM_PASSWORD=...
# Per-profile camera secrets stay in the host environment; API stores only
# references such as env:CAMERA_CREDENTIAL_NVR_A.
# CAMERA_CREDENTIAL_NVR_A=...
# Password kamera yang diisi dari UI (Kelola kredensial) disimpan di file ini (0600),
# bukan di DB. WAJIB di luar STORAGE_ROOT. Default: ~/.isentinel/camera-secrets.json
# CAMERA_SECRETS_FILE=/home/isentinel/.isentinel/camera-secrets.json
# Runtime data lives outside the Git worktree; override per host.
STORAGE_ROOT=/home/gspe-ai3/project_cv/I-Sentinel-data/api
FACE_MODEL_DIR=/home/gspe-ai3/project_cv/I-Sentinel-data/api/faces_models
# Satu absensi per karyawan dan arah dalam jendela waktu ini (menit).
ATTENDANCE_COOLDOWN_MIN=5
VISION_DATA_DIR=/home/gspe-ai3/project_cv/I-Sentinel-data/vision
MQTT_URL=localhost:1883
GO2RTC_URL=http://localhost:1984
# Host go2rtc yang dipakai browser (klien LAN). Kosongkan hanya kalau tidak ada
# proxy di depan API — kalau kosong, host diambil dari header Host request.
GO2RTC_PUBLIC_HOST=
RETENTION_DAYS=30
