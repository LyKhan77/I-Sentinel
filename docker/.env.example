# Copy is not required: setup.sh generates private random values in docker/.env.
HOST_UID=1000
HOST_GID=1000
TZ=Asia/Jakarta
DATA_DIR=../../I-Sentinel-docker-data
GO2RTC_PUBLIC_HOST=192.0.2.10
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
NODE_API_KEY=CHANGE_ME
MQTT_USERNAME=isentinel
MQTT_PASSWORD=CHANGE_ME
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
VISION_NODE_ID=1
# Provisional; measure the real clip ring before server cutover.
VISION_SHM_SIZE=2gb
VISION_ENGINE_GPU=0
COMPOSE_PROFILES=vision
RETENTION_DAYS=30
